{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    { "src": "/daily-word", "status": 308, "headers": { "Location": "/word-lee" } },
    { "src": "/nl/daily-word", "status": 308, "headers": { "Location": "/nl/word-lee" } },
    { "src": "/api/(.*)", "dest": "/api?path=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
