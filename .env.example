# Required for AI chat backend
OPENAI_API_KEY=your_openai_api_key_here

# Optional: change model
OPENAI_MODEL=gpt-4.1-mini

# Optional API port
PORT=3001

# Optional: persistent Word-Lee leaderboard (Upstash/Vercel KV REST credentials)
KV_REST_API_URL=https://your-kv-rest-endpoint
KV_REST_API_TOKEN=your_kv_rest_token
